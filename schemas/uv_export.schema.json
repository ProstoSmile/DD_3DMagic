{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dd-3dmagic.example/spec/uv_export.v1.json",
  "title": "DD_3DMagic read-only UV triangle export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "triangles"],
  "properties": {
    "schema_version": {"const": 1},
    "triangles": {
      "type": "array", "maxItems": 2000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["object", "positions_m", "uv"],
        "properties": {
          "object": {"type": "string", "minLength": 1},
          "positions_m": {"$ref": "#/$defs/tri3"},
          "uv": {"$ref": "#/$defs/tri2"}
        }
      }
    }
  },
  "$defs": {
    "coord3": {"type": "array", "prefixItems": [{"type": "number"},{"type": "number"},{"type": "number"}], "minItems": 3, "maxItems": 3},
    "coord2": {"type": "array", "prefixItems": [{"type": "number"},{"type": "number"}], "minItems": 2, "maxItems": 2},
    "tri3": {"type": "array", "items": {"$ref": "#/$defs/coord3"}, "minItems": 3, "maxItems": 3},
    "tri2": {"type": "array", "items": {"$ref": "#/$defs/coord2"}, "minItems": 3, "maxItems": 3}
  }
}
